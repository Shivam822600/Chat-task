PORT=3000
DATABASE_URL=postgres://chat:chat@localhost:5432/chatdb

# Firebase: use ONE of the options below.
# Option A - service account JSON file (real Firestore)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Option B - local Firestore emulator (no credentials needed)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-chat
